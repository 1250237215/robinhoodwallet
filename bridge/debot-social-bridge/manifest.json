{
  "manifest_version": 3,
  "name": "Radar DeBot Social Bridge",
  "version": "1.10.9",
  "description": "Synchronizes a signed-in DeBot social monitor with a user-configured Radar server.",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": [
    "https://debot.ai/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Radar DeBot Social Bridge"
  },
  "content_scripts": [
    {
      "matches": ["https://debot.ai/*"],
      "js": ["debot-page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://debot.ai/*"],
      "js": ["debot-relay.js"],
      "run_at": "document_start"
    }
  ]
}

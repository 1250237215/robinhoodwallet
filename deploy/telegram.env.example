# Optional Telegram viewer overrides. Keep Telegram API credentials and the
# login session in /var/lib/robinhood-radar/telegram; never place them here.
TG_VIEWER_BLOCKED_CHAT_IDS=
# Stable ID for the fixed Telegram panel and its sender-specific CA rules.
TG_PINNED_CHAT_ID=
# Optional: set the same random value as TELEGRAM_BARK_INTERNAL_TOKEN in
# robinhood.env to enable Telegram CA Bark delivery.
TELEGRAM_BARK_INTERNAL_TOKEN=

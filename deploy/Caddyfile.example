# Set these Caddy environment variables for the production host. The defaults
# are local-only and safe for validating this example on a fresh machine.
{$RADAR_LEGACY_SITE_ADDRESS:http://localhost:8080} {
	@legacyRadarPage path /robinhood-radar /robinhood-radar/*
	redir @legacyRadarPage {$RADAR_CANONICAL_ORIGIN:http://localhost}{uri} 308
}

{$RADAR_SITE_ADDRESS:http://localhost} {
	@compressible not path /robinhood-radar/api/social/stream /robinhood-radar/api/robinhood/monitor/stream /robinhood-radar/api/base/monitor/stream /robinhood-radar/api/bsc/monitor/stream /robinhood-radar/api/solana/monitor/stream
	encode @compressible zstd gzip
	header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	@solanaWebhook path /robinhood-radar/api/solana/monitor/webhook
	handle @solanaWebhook {
		uri strip_prefix /robinhood-radar
		reverse_proxy 127.0.0.1:18120 {
			header_up X-Forwarded-Proto {scheme}
			header_up Host {host}
		}
	}

	redir /robinhood-radar /robinhood-radar/ 308

	handle /robinhood-radar/api/social/stream {
		uri strip_prefix /robinhood-radar
		reverse_proxy 127.0.0.1:18118 {
			header_up X-Forwarded-Proto {scheme}
			header_up Host {host}
			flush_interval -1
		}
	}

	handle /robinhood-radar/api/robinhood/monitor/stream {
		uri strip_prefix /robinhood-radar
		reverse_proxy 127.0.0.1:18118 {
			header_up X-Forwarded-Proto {scheme}
			header_up Host {host}
			flush_interval -1
		}
	}

	handle /robinhood-radar/api/base/monitor/stream {
		uri strip_prefix /robinhood-radar
		reverse_proxy 127.0.0.1:18119 {
			header_up X-Forwarded-Proto {scheme}
			header_up Host {host}
			flush_interval -1
		}
	}

	handle /robinhood-radar/api/bsc/monitor/stream {
		uri strip_prefix /robinhood-radar
		reverse_proxy 127.0.0.1:18122 {
			header_up X-Forwarded-Proto {scheme}
			header_up Host {host}
			flush_interval -1
		}
	}

	handle /robinhood-radar/api/solana/monitor/stream {
		uri strip_prefix /robinhood-radar
		reverse_proxy 127.0.0.1:18120 {
			header_up X-Forwarded-Proto {scheme}
			header_up Host {host}
			flush_interval -1
		}
	}

	handle /robinhood-radar/api/robinhood/* {
		uri strip_prefix /robinhood-radar
		reverse_proxy 127.0.0.1:18118 {
			header_up X-Forwarded-Proto {scheme}
			header_up Host {host}
		}
	}

	handle /robinhood-radar/api/base/* {
		uri strip_prefix /robinhood-radar
		reverse_proxy 127.0.0.1:18119 {
			header_up X-Forwarded-Proto {scheme}
			header_up Host {host}
		}
	}

	handle /robinhood-radar/api/bsc/* {
		uri strip_prefix /robinhood-radar
		reverse_proxy 127.0.0.1:18122 {
			header_up X-Forwarded-Proto {scheme}
			header_up Host {host}
		}
	}

	handle /robinhood-radar/api/solana/* {
		uri strip_prefix /robinhood-radar
		reverse_proxy 127.0.0.1:18120 {
			header_up X-Forwarded-Proto {scheme}
			header_up Host {host}
		}
	}

	handle /robinhood-radar/internal/* {
		respond "Not found" 404
	}

	handle_path /robinhood-radar/* {
		reverse_proxy 127.0.0.1:18118 {
			header_up X-Forwarded-Proto {scheme}
			header_up Host {host}
		}
	}
}

# Install as /etc/robinhood-radar/social.env with mode 0600.
# Generate a long random bridge token before connecting a browser bridge.
SOCIAL_BRIDGE_TOKEN=

# Comma-separated X handles eligible for the optional low-latency lane.
SOCIAL_X_FAST_HANDLES=
SOCIAL_X_FAST_POLL_INTERVAL_MS=500
SOCIAL_X_FAST_MAX_IN_FLIGHT=3
SOCIAL_X_FAST_REQUEST_TIMEOUT_MS=3500
SOCIAL_X_REPLY_ENRICHMENT=true

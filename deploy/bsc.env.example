# Install as /etc/robinhood-radar/bsc.env with mode 0600.
# The live monitor has a no-key public default with a 10-block log limit.
# Set your own full endpoint for production reliability. Startup verifies that
# recent batched transactions and receipts are available before opening data.
BSC_RPC_URL=

# Default manual CA / smart-wallet analysis uses the signed-in DeBot extension
# to fetch the top 100 current Holders. This fixed internal endpoint is owned by
# the Robinhood service and must remain loopback-only; never proxy /internal/*.
BSC_DEBOT_BRIDGE_URL=http://127.0.0.1:18118/internal/debot/request
BSC_DEBOT_BRIDGE_TIMEOUT_MS=90000
# Keep the outer request timeout strictly above the browser-bridge timeout.
BSC_DEBOT_REQUEST_TIMEOUT_MS=95000

# Optional strict mode. When set, this archive RPC replaces the top-100 DeBot
# Holder source with complete ERC-20 Transfer-ledger reconstruction. It must
# support historical eth_getCode and complete, large-range eth_getLogs queries.
BSC_HOLDER_RPC_URL=
# Strict-mode development escape hatch only. Keep false in production so a full
# Holder replay cannot consume the live monitor endpoint's quota.
BSC_ALLOW_SHARED_RPC_ENDPOINT=false

# Optional production tuning overrides.
BSC_REQUEST_TIMEOUT_MS=20000
BSC_MARKET_REQUEST_TIMEOUT_MS=5000
BSC_MONITOR_POLL_INTERVAL_MS=500
BSC_MONITOR_LOG_CONCURRENCY=2
BSC_MONITOR_MAX_BLOCK_SPAN=10

# Used only when BSC_HOLDER_RPC_URL enables strict Transfer-ledger mode. Raise
# limits only after confirming that the archive RPC can sustain the larger scan.
BSC_HOLDER_LOG_WINDOW=2000
BSC_HOLDER_LOG_CONCURRENCY=2
BSC_HOLDER_LOG_RESULT_GUARD=1000
BSC_HOLDER_MAX_TRANSFER_LOGS=100000
BSC_HOLDER_MAX_BLOCK_SPAN=5000000
BSC_HOLDER_CREATION_SAFETY_SECONDS=86400
BSC_HOLDER_RPC_BATCH_SIZE=20
BSC_HOLDER_MAX_BALANCE_CHECKS=20000
BSC_HOLDER_MAX_CONTRACT_CHECKS=1000

# Install as /etc/robinhood-radar/translation.env with mode 0600.
# Keep the production key out of Git, browser extensions, databases, and logs.
DEEPSEEK_TRANSLATION_API_KEY=
DEEPSEEK_TRANSLATION_BASE_URL=https://api.deepseek.com
DEEPSEEK_TRANSLATION_MODEL=deepseek-v4-flash
DEEPSEEK_TRANSLATION_TIMEOUT_MS=4000
DEEPSEEK_TRANSLATION_CONCURRENCY=3
DEEPSEEK_TRANSLATION_MAX_ATTEMPTS=2
DEEPSEEK_TRANSLATION_RETRY_DELAY_MS=200
DEEPSEEK_TRANSLATION_MAX_QUEUE=1000
DEEPSEEK_TRANSLATION_CACHE_SIZE=2000
